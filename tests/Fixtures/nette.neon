redis:
	connections:
		default:
			host: %redisHost%
			port: %redisPort%
			database: %cacheDatabase%
		sessions:
			host: %redisHost%
			port: %redisPort%
			database: %sessionDatabase%
	cache:
		enabled: true
	sessions:
		enabled: true
		connection: sessions
		prefix: 'nette-session:'
	locks:
		enabled: true

services:
	redisGc: Mistrfilda\Redis\Bridges\Symfony\Console\CacheGarbageCollectCommand(@redis.cache)
